msgstr "Modificato parzialmente (adattamenti minori)"

msgid "Reescrito sustancialmente"
msgstr "Riscritto sostanzialmente"

msgid "Usado solo como inspiración/referencia"
msgstr "Usato solo come ispirazione/riferimento"

msgid "Sintetizado con otras fuentes"
msgstr "Sintetizzato con altre fonti"

msgid "Otro"
msgstr "Altro"

# Human Review Levels
msgid "Nivel 0: Sin Revisión"
msgstr "Livello 0: Nessuna Revisione"

msgid "El contenido generado se utilizó directamente sin verificación humana (RIESGO ALTO)."
msgstr "Il contenuto generato è stato utilizzato direttamente senza verifica umana (RISCHIO ALTO)."

msgid "Nivel 1: Revisión Superficial"
msgstr "Livello 1: Revisione Superficiale"

msgid "Lectura rápida para verificar coherencia general, sin entrar en detalles de exactitud."
msgstr "Lettura rapida per verificare la coerenza generale, senza entrare nei dettagli di precisione."

msgid "Nivel 2: Revisión Gramatical"
msgstr "Livello 2: Revisione Grammaticale"

msgid "Corrección de errores tipográficos, sintaxis y tono, asumiendo la veracidad del contenido."
msgstr "Correzione di errori tipografici, sintassi e tono, assumendo la veridicità del contenuto."

msgid "Nivel 3: Verificación Selectiva"
msgstr "Livello 3: Verifica Selettiva"

msgid "Comprobación aleatoria (spot-checking) de datos clave o afirmaciones dudosas."
msgstr "Controllo casuale (spot-checking) di dati chiave o affermazioni dubbie."

msgid "Nivel 4: Contrastación Documental"
msgstr "Livello 4: Verifica Documentale"

msgid "Verificación de citas, referencias y datos contra fuentes primarias fiables."
msgstr "Verifica di citazioni, riferimenti e dati contro fonti primarie affidabili."

msgid "Nivel 5: Validación Experta"
msgstr "Livello 5: Validazione Esperta"

msgid "Revisión profunda por un experto en la materia para asegurar integridad lógica y metodológica."
msgstr "Revisione approfondita da parte di un esperto della materia per garantire l'integrità logica e metodologica."

msgid "Nivel 6: Revisión Crítica y Ética"
msgstr "Livello 6: Revisione Critica ed Etica"

msgid "Análisis exhaustivo de sesgos, originalidad, ética y precisión técnica (Estándar \"Gold\")."
msgstr "Analisi esaustiva di bias, originalità, etica e precisione tecnica (Standard \"Oro\")."

