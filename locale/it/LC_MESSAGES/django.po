# Step 2 - Usage Types
msgid "Generación de Borrador"
msgstr "Generazione di Bozza"

msgid "La IA escribió una primera versión completa o secciones sustanciales que sirvieron de base."
msgstr "L'IA ha scritto una prima versione completa o sezioni sostanziali che hanno servito da base."

msgid "Co-creación Sustantiva"
msgstr "Co-creazione Sostanziale"

msgid "Colaboración iterativa donde la IA y el humano construyen argumentos o narrativas conjuntamente."
msgstr "Collaborazione iterativa dove IA e umano costruiscono argomenti o narrative congiuntamente."

msgid "Asistencia de Estilo y Redacción"
msgstr "Assistenza di Stile e Redazione"

msgid "Mejora de la forma sin alterar el fondo o las ideas principales."
msgstr "Miglioramento della forma senza alterare il contenuto o le idee principali."

msgid "Parafraseo para mejorar fluidez"
msgstr "Parafrasi per migliorare la fluidità"

msgid "Corrección gramatical y ortográfica"
msgstr "Correzione grammaticale e ortografica"

msgid "Adaptación de texto a formato académico estándar"
msgstr "Adattamento del testo al formato accademico standard"

msgid "Ideación y Estructura"
msgstr "Ideazione e Struttura"

msgid "Apoyo en la fase previa a la escritura (brainstorming, esquemas)."
msgstr "Supporto nella fase di pre-scrittura (brainstorming, schemi)."

msgid "Análisis de Datos"
msgstr "Analisi dei Dati"

msgid "Uso de capacidades computacionales para sintetizar o transformar información."
msgstr "Uso di capacità computazionali per sintetizzare o trasformare informazioni."

msgid "Generación de Código"
msgstr "Generazione di Codice"

msgid "Creación de scripts, algoritmos o modelos matemáticos."
msgstr "Creazione di script, algoritmi o modelli matematici."

msgid "Traducción Técnica"
msgstr "Traduzione Tecnica"

msgid "Traducción de textos académicos o técnicos entre idiomas."
msgstr "Traduzione di testi accademici o tecnici tra lingue."

msgid "Simulación de Revisión (Feedback)"
msgstr "Simulazione di Revisione (Feedback)"

msgid "La IA actúa como \"abogado del diablo\" o revisor par simulado."
msgstr "L'IA agisce come \"avvocato del diavolo\" o revisore paritario simulato."

msgid "Otro uso no listado"
msgstr "Altro uso non elencato"

msgid "Cualquier otro uso que no encaje en las categorías anteriores."
msgstr "Qualsiasi altro uso che non rientri nelle categorie precedenti."

